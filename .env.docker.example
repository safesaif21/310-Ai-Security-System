# ==========================================
# FRONTEND CONFIGURATION (Needed for Docker)
# ==========================================

# The URL of your backend API.
# Since you are running the backend locally on one machine:
# 1. Accessing via LAN: Use the LAN IP of that machine (e.g., http://192.168.1.5:8000)
# 2. Accessing on the same machine: You can use http://localhost:8000 (if exposing port 8000)
VITE_API_URL=http://replace_with_your_backend_ip:8000

VITE_APP_NAME=AI Security System

# ==========================================
# BACKEND REFERENCE (NOT needed for Frontend Docker)
# ==========================================
# These variables are only used by the backend application.
# Since your backend is running locally (not in Docker), 
# it will continue to use your original `.env` file.
# 
# DO NOT expose these to the frontend build for security reasons.

# MONGODB_URI=mongodb://localhost:27017/
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
