# Example .env file for MongoDB setup
# Copy this to .env and fill in your values

# ===========================================
# MongoDB Connection (REQUIRED)
# ===========================================
# Get this from MongoDB Atlas or use local MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=security_system

# For local MongoDB (alternative):
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=security_system

# ===========================================
# Security (REQUIRED)
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS Settings
# ===========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ===========================================
# Application Settings
# ===========================================
APP_NAME=AI Security System
APP_VERSION=1.0.0
ENVIRONMENT=development

# ===========================================
# Server
# ===========================================
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ===========================================
# Storage
# ===========================================
MODELS_FOLDER=yolo_models
RECORDINGS_FOLDER=recordings
MASTER_FOLDER=master
LOGS_FOLDER=logs

RECORDING_SIZE_LIMIT_GB=1.0
MASTER_SIZE_LIMIT_GB=1.0

# ===========================================
# Camera Settings
# ===========================================
MAX_CAMERAS=10
FIXED_CAMERA_COUNT=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
MAX_CONSECUTIVE_FAILURES=30

# ===========================================
# Recording Settings
# ===========================================
RECORDING_FPS=20
RECORDING_ROTATION_SECONDS=60
JPEG_QUALITY=85

MASTER_WIDTH=640
MASTER_HEIGHT=480
MASTER_CELL_WIDTH=320
MASTER_CELL_HEIGHT=240

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30

# ===========================================
# Monitoring
# ===========================================
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ===========================================
# Feature Flags
# ===========================================
ENABLE_MASTER_RECORDING=true
ENABLE_DETECTION_LOGGING=true
ENABLE_AUTO_CLEANUP=true

# ===========================================
# Development
# ===========================================
DEBUG=false
TESTING=false
